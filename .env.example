# Chen Logistics — environment
# Copy to .env.local for local development. Never commit real secrets.

# Database (native MongoDB driver). Leave empty to auto-start a local dev MongoDB.
MONGO_URI=

# Auth.js / NextAuth v5
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional OAuth providers. Credentials sign-in works without them.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional online payment collection. Offline invoice/payment recording works without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional mapping/geocoding. Without it the app renders hub-sequence route timelines
# and explicitly labels map integration as unavailable — no fabricated GPS.
MAP_PROVIDER=
MAP_API_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: port used by the auto-started local development MongoDB.
LOCAL_MONGO_PORT=27017
